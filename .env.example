# LocalHarvey environment
# Copy to .env and adjust if needed.

# Must stay pointing at localhost — the application will refuse non-local hosts
OLLAMA_HOST=http://127.0.0.1:11434

# Profile: auto | standard | high | minimal
# standard = ordinary laptop (qwen2.5:7b-instruct)
# high     = 16GB+ RAM / GPU (qwen2.5:14b-instruct)
# minimal  = low RAM (phi3:mini)
PROFILE=auto

# Optional explicit overrides (leave blank to use profile/hardware)
DEFAULT_MODEL=
FALLBACK_MODEL=

# Embeddings — Apache-2.0 (all-MiniLM-L6-v2 via sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

DEBUG=true
